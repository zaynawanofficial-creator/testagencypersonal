---
import Base from "../layouts/Base.astro";
import HeroArt from "../components/HeroArt.astro";
import BrandArt from "../components/BrandArt.astro";
import ServiceArt from "../components/ServiceArt.astro";
import WorkedExample from "../components/WorkedExample.astro";
import Process from "../components/Process.astro";
import Faq from "../components/Faq.astro";
import Price from "../components/Price.astro";
import { byFamily, byId, classLabel, familyStartingPrice, packageAnchor } from "../data/catalogue";
import { familyByName, orderedFamilies } from "../data/families";
import { site } from "../data/site";

const [seo, ...others] = orderedFamilies;
const paths = [
  { title: "Diagnose first", body: "A fixed-price audit tells you what to fix, and in what order, before bigger spend.", slug: "seo", ids: [8, 1, 47] },
  { title: "Build or rebuild", body: "Websites and stores with a defined page or product count, tested before launch.", slug: "web-design-development", ids: [31, 43, 30] },
  { title: "Ongoing support", body: "Monthly work against agreed priorities, billed in advance, month to month.", slug: "website-maintenance", ids: [14, 34, 7] },
];
const linkTo = (id: number) => `/services/${familyByName(byId(id).family).slug}/#${packageAnchor(byId(id))}`;
const faqs = [
  { q: "How much do your services cost?", a: `Every package has a published price in US dollars. One-time packages range from $179 for an SEO blog article to $4,250 for a Shopify or WooCommerce growth store; monthly services start at $129/month. Bespoke work shows a "from" price and is quoted by proposal. ${site.taxNote}` },
  { q: "What is not included in the price?", a: `${site.thirdPartyNote} Each package lists its own exclusions.` },
  { q: "How do monthly services work?", a: "Monthly services are paid in advance and run month to month. To stop, give at least seven days' notice before the next billing period." },
  { q: "How many revisions do I get?", a: "Usually one or two consolidated rounds. The exact limit is written on each package and takes priority." },
  { q: "When does work start?", a: "Lead times are listed on every package and start once we have the inputs and access that package needs." },
  { q: "Do you guarantee rankings, traffic or sales?", a: "No. Search engines, platforms and markets are outside anyone's control, so we do not promise rankings, traffic, AI citations, map positions or revenue. We commit to the agreed scope, the reasoning behind it and clear reporting." },
  { q: "Do you sell likes, followers, reviews or paid links?", a: "No. We do not sell bought likes, views, followers or reviews, and we never present paid links as editorial endorsements. Any paid placement needs your approval of the cost and is disclosed in line with current guidance." },
  { q: "Who owns the accounts and the store?", a: "You do. Ad accounts, analytics and stores stay in your name. For ecommerce work you remain the merchant of record; we do not hold client funds or buy inventory." },
  { q: "Which platforms do you work with?", a: "WordPress, WooCommerce and Shopify as standard. Other technologies are available by proposal." },
];
const schema = [
  { "@context": "https://schema.org", "@type": "Organization", name: site.brand, url: new URL("/", Astro.site).href, founder: { "@type": "Person", name: site.founder } },
  { "@context": "https://schema.org", "@type": "WebSite", name: site.brand, url: new URL("/", Astro.site).href },
];
---
<Base
  title="SEO Booster: SEO & Digital Marketing Services for SMEs and Ecommerce Brands"
  description="Founder-led SEO, digital marketing, content, web design, maintenance, graphic design and ecommerce services. Published USD prices, written scope and clear exclusions. No ranking guarantees."
  schema={schema}
>
  <section class="hero field-cobalt" aria-labelledby="hero-h">
    <div class="wrap hero__grid">
      <div class="hero__copy">
        <p class="eyebrow eyebrow--dark">SEO-led agency for SMEs and ecommerce brands</p>
        <h1 id="hero-h">Get found by the customers <span class="uline">already searching</span> for you</h1>
        <p class="hero__lead">SEO, digital marketing, content, websites, design and ecommerce services. Every package has a published price, a written scope and clear limits.</p>
        <div class="btn-row">
          <a class="btn btn--lime" href="/contact-us/">Discuss your project</a>
          <a class="btn btn--ghost-dark" href="/services/seo/">Explore SEO services</a>
        </div>
      </div>
      <div class="hero__art"><HeroArt /></div>
    </div>
  </section>

  <section class="strip" aria-label="SEO Booster at a glance">
    <ul class="wrap strip__list">
      <li><strong>50 approved packages</strong><span>with published USD prices</span></li>
      <li><strong>7 service areas</strong><span>planned to work together</span></li>
      <li><strong>Founder-led delivery</strong><span>with vetted specialists</span></li>
    </ul>
  </section>

  <section class="section" aria-labelledby="svc-h">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">Services</p>
          <h2 id="svc-h">Seven service areas, one plan</h2>
        </div>
        <p>SEO is our core strength. The other six cover what search traffic lands on and what turns it into enquiries and sales.</p>
      </div>

      <a class="seo-card" href={`/services/${seo.slug}/`}>
        <div class="seo-card__copy">
          <p class="seo-card__meta">{byFamily(seo.name).length} packages · {familyStartingPrice(seo.name)} USD</p>
          <h3>SEO services</h3>
          <p>{seo.benefit}</p>
          <ul>
            <li>Audits for sites of up to 100, 500 or 1,000 URLs</li>
            <li>On-page and technical fix sprints</li>
            <li>Local SEO, citations and legitimate listings</li>
            <li>Monthly SEO growth from $900/month</li>
          </ul>
          <span class="link-arrow">Explore SEO services</span>
        </div>
        <div class="seo-card__art"><ServiceArt slug="seo" /></div>
      </a>

      <div class="svc-grid">
        {others.map((f) => (
          <a class="svc" href={`/services/${f.slug}/`}>
            <div class="svc__art"><ServiceArt slug={f.slug} /></div>
            <div class="svc__body">
              <h3>{f.navLabel}</h3>
              <p>{f.benefit}</p>
              <p class="svc__meta"><span>{familyStartingPrice(f.name)} USD</span><span class="link-arrow" aria-hidden="true">View packages</span></p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <div class="section section--white">
    <div class="wrap"><WorkedExample /></div>
  </div>

  <section class="section" aria-labelledby="how-h">
    <div class="wrap">
      <div class="section-head">
        <p class="eyebrow">How we work</p>
        <h2 id="how-h">Four stages, each with a clear output</h2>
        <p class="muted">A single article or a monthly retainer follows the same pattern, so you always know what comes next. <a href="/our-approach/">Read our full approach</a>.</p>
      </div>
      <Process steps={[
        { title: "Discovery", body: "A short intake, the access the package needs and a recorded starting point.", output: "Agreed brief" },
        { title: "Strategy", body: "Priorities, sequencing and acceptance criteria agreed in writing before delivery starts.", output: "Prioritised plan" },
        { title: "Execution", body: "Delivery within the stated scope, shared for approval at the agreed points.", output: "Scoped implementation" },
        { title: "Reporting", body: "What was done, the evidence behind it and what comes next.", output: "Handover or report" },
      ]} />
    </div>
  </section>

  <section class="section section--white" aria-labelledby="paths-h">
    <div class="wrap">
      <div class="section-head section-head--split">
        <div>
          <p class="eyebrow">Where to start</p>
          <h2 id="paths-h">Three common starting points</h2>
        </div>
        <p>All prices in US dollars (USD). Each package page lists the full scope and exclusions.</p>
      </div>
      <div class="paths">
        {paths.map((path) => (
          <section class="path" aria-labelledby={`path-${path.slug}`}>
            <div class="path__head">
              <span class="path__motif" aria-hidden="true"><ServiceArt slug={path.slug} /></span>
              <div>
                <h3 id={`path-${path.slug}`}>{path.title}</h3>
                <p>{path.body}</p>
              </div>
            </div>
            <ul class="path__rows">
              {path.ids.map((id) => {
                const p = byId(id);
                return (
                  <li>
                    <a href={linkTo(id)}><span class="path__name">{p.name}</span><span class="path__type">{classLabel[p.classification]}</span></a>
                    <Price pkg={p} currency={false} />
                  </li>
                );
              })}
            </ul>
          </section>
        ))}
      </div>
      <p class="paths__all"><a class="link-arrow" href="/services/">Compare all 50 packages</a></p>
    </div>
  </section>

  <section class="section dark founder" aria-labelledby="founder-h">
    <div class="wrap founder__grid">
      <div>
        <p class="eyebrow">Founder-led</p>
        <h2 id="founder-h">You work directly with the person accountable for delivery</h2>
        <p>SEO Booster is led by {site.founder}. Zain scopes each project, stays accountable for delivery and brings in vetted specialists where the work needs them, such as a native-language reviewer or a platform-specific ads specialist.</p>
        <ul class="founder__points">
          <li><strong>Agreed scope</strong> What is included, excluded and needed from you is written down before work starts.</li>
          <li><strong>Direct accountability</strong> One lead from first conversation to final handover.</li>
          <li><strong>Visible progress</strong> Work is shared at agreed points and every package ends with defined evidence.</li>
          <li><strong>Explicit third-party costs</strong> Ad spend, licences and publisher fees are yours to approve, never added silently.</li>
        </ul>
        <a class="btn btn--lime" href="/about/">About SEO Booster</a>
      </div>
      <div class="founder__art" aria-hidden="true">
        <BrandArt />
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-h">
    <div class="wrap faq-grid">
      <div>
        <p class="eyebrow">Questions</p>
        <h2 id="faq-h">Pricing and engagement, answered plainly</h2>
        <p class="muted">{site.currencyNote} {site.taxNote}</p>
      </div>
      <Faq faqs={faqs} />
    </div>
  </section>

  <section class="cta-wrap" aria-labelledby="cta-h">
    <div class="wrap">
      <div class="cta field-cobalt">
        <div>
          <h2 id="cta-h">Tell us what you want to improve</h2>
          <p>Share your website, the service or package you are interested in and what a good result looks like. You will get an honest view of whether we can help and what it would involve.</p>
        </div>
        <a class="btn btn--lime" href="/contact-us/">Discuss your project</a>
      </div>
    </div>
  </section>
</Base>

<style>
  /* Hero */
  .hero { padding-block: clamp(48px, 6vw, 88px) clamp(48px, 6vw, 96px); overflow: hidden; }
  .hero__grid { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: clamp(24px, 4vw, 56px); align-items: center; }
  .hero h1 { max-width: 16ch; color: var(--white); }
  .uline { text-decoration: underline; text-decoration-color: var(--lime); text-decoration-thickness: 0.12em; text-underline-offset: 0.14em; text-decoration-skip-ink: none; }
  .hero__lead { font-size: var(--fs-lead); line-height: 1.55; color: #dfe7f8; max-width: 44ch; margin-bottom: 32px; }
  .eyebrow--dark { color: #c9d6f2; }
  .hero__art { margin-right: calc(-1 * var(--gutter) / 2); }
  @media (max-width: 900px) {
    .hero__grid { grid-template-columns: 1fr; }
    .hero__art { max-width: 520px; margin: 8px auto -24px; width: 100%; aspect-ratio: 800 / 460; overflow: hidden; }
    .hero__art :global(svg) { margin-top: -6%; }
  }

  /* Proof strip */
  .strip { background: var(--white); border-bottom: 1px solid var(--border); }
  .strip__list { list-style: none; margin: 0 auto; padding: 22px 0; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 16px; }
  .strip__list li { display: flex; flex-direction: column; gap: 2px; padding-left: 18px; border-left: 3px solid var(--lime); }
  .strip__list strong { font: 700 1.1rem/1.3 var(--font-head); }
  .strip__list span { color: var(--slate); font-size: 0.95rem; }
  @media (max-width: 700px) { .strip__list { grid-template-columns: 1fr; gap: 14px; } }

  /* Services */
  .seo-card { display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 0.9fr); gap: 32px; align-items: center; padding: clamp(28px, 4vw, 48px); background: var(--blue-tint); border: 1px solid #d5e0fb; border-radius: 20px; color: var(--ink); text-decoration: none; margin-bottom: 20px; transition: border-color .15s ease; }
  .seo-card:hover { border-color: var(--blue); color: var(--ink); text-decoration: none; }
  .seo-card h3 { font-size: clamp(1.6rem, 1.3rem + 1vw, 2.1rem); margin: 8px 0 10px; }
  .seo-card p { color: #2b3b54; max-width: 52ch; }
  .seo-card__meta { font-size: 0.85rem; font-weight: 600; color: var(--slate) !important; margin: 0; }
  .seo-card ul { list-style: none; margin: 18px 0 22px; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 10px 24px; font-size: 0.97rem; }
  .seo-card li { display: flex; gap: 10px; }
  .seo-card li::before { content: ""; flex: none; width: 10px; height: 10px; margin-top: 0.5em; border-radius: 3px; background: var(--blue); }
  .seo-card .link-arrow { color: var(--blue); }
  .svc-grid { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 20px; }
  .svc { display: flex; flex-direction: column; background: var(--white); border: 1px solid var(--border); border-radius: 18px; overflow: hidden; color: var(--ink); text-decoration: none; transition: border-color .15s ease; }
  .svc:hover { border-color: var(--blue); color: var(--ink); text-decoration: none; }
  .svc__art { background: var(--blue-tint); padding: 12px 24px 0; }
  .svc__body { display: flex; flex-direction: column; flex: 1; padding: 22px 24px 24px; }
  .svc h3 { margin-bottom: 8px; font-size: 1.25rem; }
  .svc p { color: var(--slate); margin: 0 0 16px; font-size: 0.97rem; }
  .svc__meta { margin: auto 0 0 !important; display: flex; justify-content: space-between; gap: 12px; flex-wrap: wrap; font-size: 0.9rem !important; font-weight: 600; color: var(--ink) !important; }
  .svc__meta .link-arrow { color: var(--blue); }
  @media (max-width: 1023px) { .svc-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } .seo-card { grid-template-columns: 1fr; } .seo-card__art { max-width: 420px; order: -1; } }
  @media (max-width: 620px) { .svc-grid { grid-template-columns: 1fr; } .seo-card ul { grid-template-columns: 1fr; } .svc__art { padding-inline: 48px; } }

  /* Starting points: rows, no nested boxes */
  .paths { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: clamp(24px, 3vw, 48px); }
  .path__head { display: flex; gap: 14px; align-items: flex-start; margin-bottom: 14px; }
  .path__motif { flex: none; width: 64px; border-radius: 12px; background: var(--blue-tint); overflow: hidden; }
  .path h3 { font-size: 1.25rem; margin: 2px 0 6px; }
  .path__head p { color: var(--slate); margin: 0; font-size: 0.95rem; }
  .path__rows { list-style: none; margin: 0; padding: 0; border-top: 2px solid var(--ink); }
  .path__rows li { display: flex; justify-content: space-between; align-items: center; gap: 12px; padding: 14px 0; border-bottom: 1px solid var(--border); }
  .path__rows a { display: grid; gap: 2px; text-decoration: none; color: var(--ink); min-height: 44px; align-content: center; }
  .path__rows a:hover .path__name { color: var(--blue); text-decoration: underline; }
  .path__name { font: 600 1rem/1.3 var(--font-head); }
  .path__type { font-size: 0.82rem; color: var(--slate); }
  .paths__all { margin: 32px 0 0; }
  @media (max-width: 960px) { .paths { grid-template-columns: 1fr; } }

  /* Founder */
  .founder__grid { display: grid; grid-template-columns: minmax(0, 1.25fr) minmax(0, 0.75fr); gap: clamp(32px, 6vw, 96px); align-items: center; }
  .founder p { max-width: 58ch; }
  .founder__points { list-style: none; margin: 28px 0 32px; padding: 0; display: grid; grid-template-columns: 1fr 1fr; gap: 20px 32px; }
  .founder__points li { color: var(--text-on-dark); font-size: 0.97rem; padding-top: 14px; border-top: 2px solid var(--lime); }
  .founder__points strong { display: block; color: var(--white); font: 600 1.05rem/1.3 var(--font-head); margin-bottom: 4px; }
  .founder__art { max-width: 360px; margin-inline: auto; width: 100%; }
  @media (max-width: 900px) { .founder__grid { grid-template-columns: 1fr; } .founder__art { display: none; } }
  @media (max-width: 560px) { .founder__points { grid-template-columns: 1fr; } }

  .faq-grid { display: grid; grid-template-columns: minmax(0, 0.8fr) minmax(0, 1.2fr); gap: clamp(32px, 6vw, 96px); align-items: start; }
  @media (max-width: 900px) { .faq-grid { grid-template-columns: 1fr; } }

  .cta-wrap { padding-bottom: var(--section); }
  .cta { border-radius: 24px; padding: clamp(32px, 5vw, 64px); display: grid; grid-template-columns: 1fr auto; gap: 32px; align-items: center; }
  .cta p { color: #dfe7f8; max-width: 60ch; margin: 0; }
  @media (max-width: 760px) { .cta { grid-template-columns: 1fr; } .cta .btn { width: 100%; } }
</style>
