---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { IS_PREVIEW, site } from "../data/site";

interface Crumb { name: string; path: string }
interface Props {
  title: string;
  description: string;
  crumbs?: Crumb[];
  schema?: Record<string, unknown>[];
  noindex?: boolean;
}
const { title, description, crumbs, schema = [], noindex = false } = Astro.props;
const path = Astro.url.pathname;
const canonical = new URL(path, Astro.site).href;
const robots = IS_PREVIEW || noindex ? "noindex, nofollow" : "index, follow";
const ld = [...schema];
if (crumbs?.length) {
  ld.push({
    "@context": "https://schema.org",
    "@type": "BreadcrumbList",
    itemListElement: crumbs.map((c, i) => ({ "@type": "ListItem", position: i + 1, name: c.name, item: new URL(c.path, Astro.site).href })),
  });
}
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    <link rel="canonical" href={canonical} />
    <meta name="theme-color" content="#152541" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.brand} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    {ld.map((d) => <script type="application/ld+json" set:html={JSON.stringify(d)} />)}
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <Header current={path} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <Footer />
    {IS_PREVIEW && <div class="preview-flag" aria-hidden="true">Preview build · not indexed</div>}
  </body>
</html>
<style is:global>
  main:focus { outline: none; }
  .preview-flag { position: fixed; left: 12px; bottom: 12px; z-index: 40; pointer-events: none; font: 600 0.75rem/1 var(--font-body); background: var(--ink); color: var(--white); padding: 7px 10px; border-radius: 999px; opacity: 0.85; }
</style>
