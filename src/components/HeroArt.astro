---
// Original SVG hero composition (fallback for the raster "hero-growth-studio" artwork; see docs/ASSETS.md).
// Decorative: no text, numbers, logos or charts. Transparent background so it blends into the cobalt field.
---
<svg class="hero-art" viewBox="0 0 800 600" role="presentation" aria-hidden="true" focusable="false" preserveAspectRatio="xMidYMid meet">
  <defs>
    <linearGradient id="ha-face" x1="0" y1="0" x2="0" y2="1">
      <stop offset="0" stop-color="#ffffff" />
      <stop offset="1" stop-color="#e9efff" />
    </linearGradient>
    <linearGradient id="ha-edge" x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" stop-color="#0e1a33" />
      <stop offset="1" stop-color="#16295a" />
    </linearGradient>
    <radialGradient id="ha-glow" cx="0.55" cy="0.45" r="0.6">
      <stop offset="0" stop-color="#3a6cff" stop-opacity="0.55" />
      <stop offset="1" stop-color="#2456e8" stop-opacity="0" />
    </radialGradient>
    <filter id="ha-shadow" x="-20%" y="-20%" width="140%" height="160%">
      <feDropShadow dx="0" dy="22" stdDeviation="18" flood-color="#050b1a" flood-opacity="0.45" />
    </filter>
  </defs>

  <ellipse cx="430" cy="280" rx="360" ry="260" fill="url(#ha-glow)" />

  <!-- Website panel (back, centre) -->
  <g filter="url(#ha-shadow)">
    <rect x="262" y="78" width="372" height="300" rx="22" fill="url(#ha-edge)" transform="translate(12 14)" />
    <rect x="262" y="78" width="372" height="300" rx="22" fill="url(#ha-face)" />
  </g>
  <rect x="262" y="78" width="372" height="44" rx="22" fill="#dfe8ff" />
  <rect x="262" y="100" width="372" height="22" fill="#dfe8ff" />
  <circle cx="290" cy="100" r="6" fill="#9fb4e6" /><circle cx="310" cy="100" r="6" fill="#9fb4e6" /><circle cx="330" cy="100" r="6" fill="#9fb4e6" />
  <rect x="290" y="146" width="178" height="20" rx="10" fill="#152541" />
  <rect x="290" y="178" width="140" height="10" rx="5" fill="#b9c7e6" />
  <rect x="290" y="196" width="160" height="10" rx="5" fill="#b9c7e6" />
  <rect x="290" y="222" width="96" height="30" rx="15" fill="#2456e8" />
  <rect x="490" y="142" width="118" height="112" rx="14" fill="#2456e8" />
  <rect x="506" y="158" width="86" height="80" rx="10" fill="#4f7bff" />
  <rect x="290" y="276" width="96" height="76" rx="12" fill="#eef3ff" stroke="#cdd9f5" stroke-width="2" />
  <rect x="400" y="276" width="96" height="76" rx="12" fill="#eef3ff" stroke="#cdd9f5" stroke-width="2" />
  <rect x="510" y="276" width="96" height="76" rx="12" fill="#eef3ff" stroke="#cdd9f5" stroke-width="2" />

  <!-- Lime path: discovery -> website -> catalogue -->
  <path d="M232 400 C 300 360, 330 330, 338 300 M 555 300 C 590 330, 610 350, 640 372" stroke="#d9f76b" stroke-width="6" stroke-linecap="round" fill="none" />
  <path d="M338 300 C 380 250, 510 250, 555 300" stroke="#d9f76b" stroke-width="6" stroke-linecap="round" fill="none" stroke-dasharray="1 14" />

  <!-- Search / discovery panel (front left) -->
  <g filter="url(#ha-shadow)">
    <rect x="70" y="352" width="300" height="168" rx="22" fill="url(#ha-edge)" transform="translate(12 14)" />
    <rect x="70" y="352" width="300" height="168" rx="22" fill="url(#ha-face)" />
  </g>
  <rect x="94" y="376" width="252" height="40" rx="20" fill="#ffffff" stroke="#2456e8" stroke-width="3" />
  <circle cx="118" cy="396" r="8" fill="none" stroke="#2456e8" stroke-width="3" />
  <path d="M124 402l7 7" stroke="#2456e8" stroke-width="3" stroke-linecap="round" />
  <rect x="142" y="391" width="120" height="10" rx="5" fill="#b9c7e6" />
  <rect x="94" y="432" width="252" height="34" rx="10" fill="#f4f8d9" stroke="#d9f76b" stroke-width="3" />
  <rect x="108" y="443" width="150" height="12" rx="6" fill="#2456e8" />
  <rect x="94" y="476" width="200" height="10" rx="5" fill="#cfd9ee" />
  <rect x="94" y="494" width="160" height="10" rx="5" fill="#cfd9ee" />

  <!-- Product catalogue panel (front right) -->
  <g filter="url(#ha-shadow)">
    <rect x="520" y="330" width="232" height="208" rx="22" fill="url(#ha-edge)" transform="translate(12 14)" />
    <rect x="520" y="330" width="232" height="208" rx="22" fill="url(#ha-face)" />
  </g>
  <rect x="542" y="352" width="88" height="76" rx="12" fill="#2456e8" />
  <rect x="642" y="352" width="88" height="76" rx="12" fill="#eef3ff" stroke="#cdd9f5" stroke-width="2" />
  <rect x="542" y="440" width="88" height="76" rx="12" fill="#eef3ff" stroke="#cdd9f5" stroke-width="2" />
  <rect x="642" y="440" width="88" height="76" rx="12" fill="#152541" />
  <rect x="556" y="404" width="56" height="10" rx="5" fill="#a9c1ff" />
  <rect x="656" y="404" width="56" height="10" rx="5" fill="#b9c7e6" />
  <circle cx="700" cy="494" r="12" fill="#d9f76b" />

  <!-- Path nodes -->
  <circle cx="232" cy="400" r="10" fill="#152541" stroke="#d9f76b" stroke-width="5" />
  <circle cx="338" cy="300" r="10" fill="#152541" stroke="#d9f76b" stroke-width="5" />
  <circle cx="555" cy="300" r="10" fill="#152541" stroke="#d9f76b" stroke-width="5" />
  <circle cx="640" cy="372" r="10" fill="#152541" stroke="#d9f76b" stroke-width="5" />
</svg>
<style>
  .hero-art { width: 100%; height: auto; display: block; overflow: visible; }
</style>
