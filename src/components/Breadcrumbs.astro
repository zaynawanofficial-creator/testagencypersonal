---
interface Props { items: { name: string; path: string }[] }
const { items } = Astro.props;
---
<nav class="crumbs" aria-label="Breadcrumb">
  <ol>
    {items.map((c, i) => (
      <li>{i === items.length - 1 ? <span aria-current="page">{c.name}</span> : <a href={c.path}>{c.name}</a>}</li>
    ))}
  </ol>
</nav>
<style>
  .crumbs { font-size: 0.9rem; color: var(--slate); margin-bottom: 24px; }
  ol { list-style: none; display: flex; flex-wrap: wrap; gap: 6px; margin: 0; padding: 0; }
  li + li::before { content: "/"; margin-right: 6px; color: #8d9aae; }
  a { color: var(--slate); }
</style>
